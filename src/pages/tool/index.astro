---
import { STEPS } from "../../lib/steps";

const stepsJson = JSON.stringify(STEPS).replace(/</g, "\\u003c");
// import.meta.env.BASE_URL isn't guaranteed to carry a trailing slash — normalize it.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Vibe-Spec Tool | Vibe Coding Playbook</title>
		<meta
			name="description"
			content="Work through the Vibe Coding Playbook interactively, draft each step with your own model API key, and export the finished docs."
		/>
		<link rel="icon" href={`${base}favicon.svg`} />
	</head>
	<body>
		<script type="application/json" id="steps-data" set:html={stepsJson} />

		<div class="app">
			<header class="topbar">
				<a class="brand" href={base}>← Vibe Coding Playbook</a>
				<h1>Vibe-Spec Tool</h1>
				<button id="settings-toggle" type="button">Settings</button>
			</header>

			<div id="settings-panel" class="settings-panel" hidden>
				<div class="field">
					<label for="project-name">Project name</label>
					<input id="project-name" type="text" placeholder="e.g. Calorie Sync" />
				</div>
				<div class="field">
					<label for="provider-select">Model provider</label>
					<select id="provider-select">
						<option value="claude">Claude — Anthropic API key</option>
						<option value="openrouter">OpenRouter — API key</option>
					</select>
				</div>
				<div class="field">
					<label for="api-key">API key</label>
					<input id="api-key" type="password" autocomplete="off" placeholder="sk-..." />
				</div>
				<div class="field">
					<label for="model-input">Model <span class="hint">(optional override)</span></label>
					<input id="model-input" type="text" placeholder="uses a sensible default" />
				</div>
				<p class="settings-note">
					Stored only in this browser's local storage. Your key is sent straight to the
					provider you pick, direct from your browser — never to any server this tool runs.
					Only Claude and OpenRouter work this way; a Codex/OpenAI key can't be used here
					because OpenAI's API blocks direct browser requests.
				</p>
				<button id="clear-data" type="button" class="danger">Clear all saved data</button>
			</div>

			<div class="layout">
				<nav class="step-list" id="step-list" aria-label="Playbook steps"></nav>

				<main class="step-panel">
					<div class="progress-track" role="progressbar" aria-label="Playbook progress">
						<div class="progress-fill" id="progress-fill"></div>
					</div>
					<p class="progress-label" id="progress-label"></p>

					<div class="step-header">
						<h2 id="step-title"></h2>
						<a id="step-readmore" href="#" target="_blank" rel="noopener">Read the full guidance →</a>
					</div>
					<p id="step-context-note" class="context-note"></p>

					<div class="field">
						<label id="notes-label" for="notes-input">Additional notes (optional)</label>
						<textarea
							id="notes-input"
							rows="3"
							placeholder="Anything you want the AI to know before drafting this step"></textarea>
					</div>

					<div class="actions">
						<button id="draft-btn" type="button">
							<span id="draft-btn-label">Draft with AI</span>
						</button>
						<span id="draft-status" class="status"></span>
					</div>
					<div class="draft-progress" id="draft-progress" hidden>
						<div class="draft-progress-fill"></div>
					</div>

					<div class="field">
						<label for="doc-editor">Document</label>
						<textarea id="doc-editor" rows="22" spellcheck="false"></textarea>
					</div>

					<div class="actions">
						<button id="save-btn" type="button">Save</button>
						<button id="reset-btn" type="button" class="secondary">Reset to blank template</button>
						<span id="save-status" class="status"></span>
					</div>

					<div class="stepper-nav">
						<button id="prev-step-btn" type="button" class="secondary">◀ Previous</button>
						<span id="stepper-position" class="status"></span>
						<button id="next-step-btn" type="button">Next ▶</button>
					</div>
				</main>
			</div>

			<footer class="export-bar">
				<span id="export-summary"></span>
				<button id="export-btn" type="button">Download as ZIP</button>
			</footer>
		</div>

		<script src="../../scripts/tool-app.ts"></script>
	</body>
</html>

<style>
	:root {
		--bg: #ffffff;
		--bg-panel: #f6f6f7;
		--border: #e2e2e5;
		--text: #1b1b1f;
		--text-muted: #6b6b75;
		--accent: #7c3aed;
		--accent-text: #ffffff;
		--accent-glow: rgba(124, 58, 237, 0.35);
		--danger: #c22;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #17171b;
			--bg-panel: #1f1f24;
			--border: #303038;
			--text: #f0f0f2;
			--text-muted: #a3a3ad;
			--accent: #a78bfa;
			--accent-text: #17171b;
			--accent-glow: rgba(167, 139, 250, 0.35);
		}
	}

	:global(html),
	:global(body) {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family:
			system-ui,
			-apple-system,
			"Segoe UI",
			sans-serif;
	}

	.app {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.topbar {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.75rem 1.25rem;
		border-bottom: 1px solid var(--border);
	}

	.topbar h1 {
		font-size: 1rem;
		margin: 0;
		flex: 1;
	}

	.brand {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
	}
	.brand:hover {
		color: var(--text);
	}

	.settings-panel {
		display: grid;
		gap: 0.75rem;
		padding: 1rem 1.25rem;
		background: var(--bg-panel);
		border-bottom: 1px solid var(--border);
		max-width: 32rem;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.field label {
		font-size: 0.85rem;
		font-weight: 600;
	}

	.hint {
		font-weight: 400;
		color: var(--text-muted);
	}

	input,
	select,
	textarea {
		font: inherit;
		padding: 0.5rem 0.6rem;
		border-radius: 6px;
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--text);
	}

	textarea {
		resize: vertical;
		font-family: ui-monospace, monospace;
		font-size: 0.85rem;
		line-height: 1.5;
	}

	.settings-note {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin: 0;
	}

	.layout {
		display: flex;
		flex: 1;
		min-height: 0;
	}

	.step-list {
		width: 15rem;
		flex-shrink: 0;
		border-right: 1px solid var(--border);
		overflow-y: auto;
		padding: 0.5rem;
	}

	.step-list button {
		display: block;
		width: 100%;
		text-align: left;
		background: none;
		border: none;
		padding: 0.5rem 0.6rem;
		border-radius: 6px;
		color: var(--text);
		cursor: pointer;
		font-size: 0.85rem;
	}

	.step-list button:hover {
		background: var(--bg-panel);
	}

	.step-list button[aria-current="true"] {
		background: var(--accent);
		color: var(--accent-text);
	}

	.step-dot {
		display: inline-block;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: var(--accent);
		margin-right: 0.4rem;
		opacity: 0;
	}
	.step-dot.saved {
		opacity: 1;
	}
	.step-list button[aria-current="true"] .step-dot.saved {
		background: var(--accent-text);
	}

	.step-panel {
		flex: 1;
		padding: 1.25rem;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.step-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.step-header h2 {
		margin: 0;
	}

	.step-header a {
		color: var(--accent);
		font-size: 0.85rem;
		white-space: nowrap;
	}

	.context-note {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	button {
		cursor: pointer;
		padding: 0.5rem 0.9rem;
		border-radius: 6px;
		border: 1px solid var(--accent);
		background: var(--accent);
		color: var(--accent-text);
		font: inherit;
		font-weight: 600;
	}

	button.secondary {
		background: none;
		color: var(--text);
		border-color: var(--border);
	}

	button.danger {
		background: none;
		color: var(--danger);
		border-color: var(--danger);
	}

	button:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.status {
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	.status.error {
		color: var(--danger);
	}

	.progress-track {
		height: 4px;
		border-radius: 2px;
		background: var(--border);
		overflow: hidden;
	}
	.progress-fill {
		height: 100%;
		width: 0%;
		background: var(--accent);
		transition: width 0.25s ease;
	}
	.progress-label {
		margin: 0;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.draft-progress {
		height: 3px;
		border-radius: 2px;
		background: var(--border);
		overflow: hidden;
		position: relative;
	}
	.draft-progress-fill {
		position: absolute;
		top: 0;
		left: -40%;
		height: 100%;
		width: 40%;
		background: var(--accent);
		animation: draft-progress-slide 1.1s ease-in-out infinite;
	}
	@keyframes draft-progress-slide {
		0% {
			left: -40%;
		}
		100% {
			left: 100%;
		}
	}

	#doc-editor {
		flex: 1;
		min-height: 20rem;
		transition: box-shadow 0.2s ease;
	}
	#doc-editor.drafting {
		box-shadow: 0 0 0 3px var(--accent-glow);
	}

	.stepper-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--border);
	}

	.export-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1.25rem;
		border-top: 1px solid var(--border);
		background: var(--bg-panel);
	}
</style>
